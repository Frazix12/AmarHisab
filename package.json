{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.2.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint",
    "test": "jest",
    "test:e2e:smoke": "maestro test -e APP_ID=com.frazix.amarisab --include-tags smoke .maestro/flows/smoke",
    "test:e2e:regression": "maestro test -e APP_ID=com.frazix.amarisab --include-tags regression .maestro/flows/regression",
    "test:e2e:ai": "maestro test -e APP_ID=com.frazix.amarisab --include-tags ai .maestro/flows/ai",
    "test:e2e:all": "maestro test -e APP_ID=com.frazix.amarisab .maestro/flows/smoke .maestro/flows/regression .maestro/flows/ai",
    "test:e2e:ci": "mkdir -p maestro-output/reports && maestro test -e APP_ID=com.frazix.amarisab --include-tags smoke --format junit --output maestro-output/reports/maestro-smoke.xml --test-output-dir maestro-output/smoke .maestro/flows/smoke && maestro test -e APP_ID=com.frazix.amarisab --include-tags regression --format junit --output maestro-output/reports/maestro-regression.xml --test-output-dir maestro-output/regression .maestro/flows/regression"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@google/generative-ai": "^0.24.1",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react-native": "^1.0.11",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "expo": "^54.0.33",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-camera": "^17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "^17.0.10",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-navigation-bar": "^5.0.10",
    "expo-router": "^6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "posthog-react-native": "^4.30.2",
    "posthog-react-native-session-replay": "^1.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/ws": "^8.18.1",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}